{
  "info": {
    "_postman_id": "2c6e5b2f-1bb5-4d6b-9b53-report-service",
    "name": "NTT Bootcamp - Report Service via API Gateway",
    "description": "Collection para probar report-service a traves de api-gateway. Ejecutar primero Auth / Login - Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": "69eaa991e7439a37a1dd72f6"
    },
    {
      "key": "start_date",
      "value": "2026-01-01T00:00:00"
    },
    {
      "key": "end_date",
      "value": "2026-12-31T23:59:59"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('access_token', response.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/auth-service/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth-service",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Get Report By Product And Date Range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/report-service/api/v1/reports/products/{{product_id}}?startDate={{start_date}}&endDate={{end_date}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "report-service",
                "api",
                "v1",
                "reports",
                "products",
                "{{product_id}}"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "{{start_date}}"
                },
                {
                  "key": "endDate",
                  "value": "{{end_date}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Last 10 Movements By Product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/report-service/api/v1/reports/products/{{product_id}}/last-10",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "report-service",
                "api",
                "v1",
                "reports",
                "products",
                "{{product_id}}",
                "last-10"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
